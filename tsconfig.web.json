{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*":       ["./src/renderer/src/*"],
      "@shared/*": ["./src/lib/*"]
    }
  },
  "include": [
    "src/lib/**/*",
    "src/renderer/**/*"
  ]
}
