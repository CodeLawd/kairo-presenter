<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/V8 JIT -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The NDI binding (@grandi) loads libndi.dylib at runtime -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Microphone capture for sermon transcription -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Camera / capture-card input on the program screens -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <!-- ProPresenter WebSocket, Bible/STT APIs, NDI discovery on the LAN -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
