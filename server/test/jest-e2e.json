{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts",
    "tsx"
  ],
  "extensionsToTreatAsEsm": [
    ".ts",
    ".tsx"
  ],
  "setupFiles": [
    "<rootDir>/test/jest-esm-setup.ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ES2022",
          "moduleResolution": "bundler"
        },
        "diagnostics": {
          "exclude": [
            "**/components/email/**"
          ]
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@contracts/(.*)$": "<rootDir>/../src/lib/cloud/$1",
    "^@/(.*)$": "<rootDir>/src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testTimeout": 60000
}