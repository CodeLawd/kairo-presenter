# Copy to .dev.vars for local wrangler dev; never commit real credentials.
MONGO_URL=mongodb://host.docker.internal:27017/proautomate
JWT_SECRET=replace-with-at-least-32-random-characters
VAULT_ENCRYPTION_KEY=replace-with-existing-vault-key
PUBLIC_WEB_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3001
