# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev: your own mongod on the default port. Production: Atlas SRV URI.
MONGO_URL=mongodb://localhost:27017/proautomate

# ─── Auth ─────────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# AES-256-GCM key for org API-key vaults at rest. Prefer 32 raw bytes as base64:
#   openssl rand -base64 32
# Plaintext secrets never sit in Mongo — only the ciphertext envelope does.
VAULT_ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32

# ─── Web / CORS ───────────────────────────────────────────────────────────────
# Comma-separated origins allowed to send credentialed requests (the web app).
# The desktop app sends no Origin header, so it needs no entry here.
WEB_ORIGIN=http://localhost:3001
# Where emailed links point (verification, invites, password reset, device pairing).
PUBLIC_WEB_URL=http://localhost:3001

# ─── Google OAuth (optional — Google sign-in is skipped when unset) ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# ─── Mail — Brevo (optional; messages are logged instead of sent when unset) ──
# Brevo → SMTP & API → API Keys. Transactional send over HTTPS, not SMTP.
BREVO_API_KEY=
# Must be a sender Brevo has verified, or every send is rejected.
BREVO_SENDER_EMAIL=no-reply@proautomate.app
BREVO_SENDER_NAME=ProAutomate
