[
  {
    "file": "audio/vo/hero-00.wav",
    "text": "The pastor goes off script.",
    "startMs": 8400,
    "durMs": 1765
  },
  {
    "file": "audio/vo/hero-01.wav",
    "text": "Nobody planned that verse.",
    "startMs": 10325,
    "durMs": 1562
  },
  {
    "file": "audio/vo/hero-02.wav",
    "text": "In the booth, someone is guessing at a reference.",
    "startMs": 12047,
    "durMs": 2864
  },
  {
    "file": "audio/vo/hero-03.wav",
    "text": "By the time it's up, the moment has passed.",
    "startMs": 15071,
    "durMs": 2605
  },
  {
    "file": "audio/vo/hero-04.wav",
    "text": "Kairo takes a clean feed from the sound desk and listens.",
    "startMs": 24400,
    "durMs": 3272
  },
  {
    "file": "audio/vo/hero-05.wav",
    "text": "It follows the sermon word by word.",
    "startMs": 29400,
    "durMs": 2110
  },
  {
    "file": "audio/vo/hero-06.wav",
    "text": "When the pastor quotes Scripture, Kairo finds the passage.",
    "startMs": 31670,
    "durMs": 3636
  },
  {
    "file": "audio/vo/hero-07.wav",
    "text": "Even when it's paraphrased, and nobody says where it's from.",
    "startMs": 35466,
    "durMs": 3526
  },
  {
    "file": "audio/vo/hero-08.wav",
    "text": "It's staged in your queue, in your translation, ready.",
    "startMs": 39400,
    "durMs": 3248
  },
  {
    "file": "audio/vo/hero-09.wav",
    "text": "You read it.",
    "startMs": 45400,
    "durMs": 782
  },
  {
    "file": "audio/vo/hero-10.wav",
    "text": "You press send.",
    "startMs": 47036,
    "durMs": 1014
  },
  {
    "file": "audio/vo/hero-11.wav",
    "text": "And the whole room reads along.",
    "startMs": 52400,
    "durMs": 1645
  },
  {
    "file": "audio/vo/hero-12.wav",
    "text": "Kairo runs the rest of Sunday, too.",
    "startMs": 55400,
    "durMs": 2529
  },
  {
    "file": "audio/vo/hero-13.wav",
    "text": "Import your sermon notes.",
    "startMs": 58089,
    "durMs": 1599
  },
  {
    "file": "audio/vo/hero-14.wav",
    "text": "Every reference becomes a verse.",
    "startMs": 59848,
    "durMs": 1843
  },
  {
    "file": "audio/vo/hero-15.wav",
    "text": "Songs keep their sections.",
    "startMs": 61851,
    "durMs": 1686
  },
  {
    "file": "audio/vo/hero-16.wav",
    "text": "Themes look exactly as they will on screen.",
    "startMs": 63697,
    "durMs": 2509
  },
  {
    "file": "audio/vo/hero-17.wav",
    "text": "Drive your screens, or send NDI to the stream.",
    "startMs": 67400,
    "durMs": 3034
  },
  {
    "file": "audio/vo/hero-18.wav",
    "text": "Arm a passage, and the next verse moves up as it's read.",
    "startMs": 71400,
    "durMs": 3316
  },
  {
    "file": "audio/vo/hero-19.wav",
    "text": "Kairo suggests.",
    "startMs": 75400,
    "durMs": 1461
  },
  {
    "file": "audio/vo/hero-20.wav",
    "text": "You decide.",
    "startMs": 77021,
    "durMs": 921
  },
  {
    "file": "audio/vo/hero-21.wav",
    "text": "Nothing reaches the screen until your team sends it.",
    "startMs": 78102,
    "durMs": 2689
  },
  {
    "file": "audio/vo/hero-22.wav",
    "text": "Kairo.",
    "startMs": 84400,
    "durMs": 683
  },
  {
    "file": "audio/vo/hero-23.wav",
    "text": "Free during early access, on Mac and Windows.",
    "startMs": 85243,
    "durMs": 3055
  },
  {
    "file": "audio/vo/hero-24.wav",
    "text": "Because every moment matters.",
    "startMs": 88957,
    "durMs": 1735
  }
]
