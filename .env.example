# ─── Desktop app build-time configuration ─────────────────────────────────────
# electron-vite loads .env from the repo root and inlines these AT BUILD TIME.
# Only prefixed keys are exposed: MAIN_VITE_ (main), PRELOAD_VITE_ (preload),
# RENDERER_VITE_ (renderer), VITE_ (all). Anything unprefixed is ignored.
#
# NEVER put a secret here. The renderer bundle ships to the user's machine and
# an .asar is just a zip — anything inlined can be read straight out of it.
# Server-side secrets (Google client secret, Brevo key, JWT secret) belong in
# server/.env and never leave the server.

# Where the desktop app finds the ProAutomate API.
MAIN_VITE_API_URL=http://localhost:3000

# The web app, for links the desktop opens in the system browser.
MAIN_VITE_WEB_URL=http://localhost:3001
