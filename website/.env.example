# Where the Next.js `/v1` proxy forwards to (server-only).
API_PROXY_TARGET=http://localhost:3000

# Records installer downloads for the admin console (server-only).
# Same value as the API's DOWNLOAD_INGEST_KEY. Unset = tracking off.
DOWNLOAD_INGEST_KEY=

# Preferred public website origin for canonical URLs, sitemap and sharing metadata.
# Defaults to https://kairopresenter.com; override only when changing the public domain.
SITE_URL=https://kairopresenter.com

# Set false for any Cloudflare staging/preview build (build-time and runtime).
SITE_INDEXING=true
