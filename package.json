{
  "name": "proautomate",
  "productName": "Kairo",
  "version": "1.0.0",
  "description": "Kairo \u2014 scripture, lyrics, and presentation for ProPresenter",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "predev": "node scripts/brand-dev-electron.mjs",
    "dev": "electron-vite dev --watch",
    "dev:update-sim": "KAIRO_UPDATE_SIM=1 electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "brand:electron": "node scripts/brand-dev-electron.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "tsx --test tests/*.test.ts",
    "test:scripture-replay": "ELECTRON_RUN_AS_NODE=1 electron --import tsx --test src/main/services/scripture/__tests__/transcript-replay.test.ts src/main/services/scripture/__tests__/quote-recovery.test.ts src/main/services/scripture/__tests__/live-detection-wiring.test.ts",
    "test:documents": "npm run build && electron tests/documents.integration.cjs",
    "test:main": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs --test src/main/__tests__/*.test.ts src/main/services/scripture/__tests__/*.test.ts src/main/services/propresenter/__tests__/*.test.ts src/main/services/cloud/__tests__/*.test.ts",
    "seed:bible": "npx tsx scripts/seed-bible.ts",
    "seed:bible:all": "npx tsx scripts/seed-bible.ts --translations KJV,BBE",
    "build:mac": "npm run typecheck && electron-vite build && electron-builder --mac --arm64",
    "release:mac": "npm run typecheck && electron-vite build && electron-builder --mac --arm64 --publish always",
    "build:mac:unsigned": "npm run typecheck && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 -c.mac.identity=null -c.mac.notarize=false",
    "build:dir": "electron-vite build && electron-builder --dir -c.mac.identity=null -c.mac.notarize=false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.0",
    "@deepgram/sdk": "^5.3.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "grandiose-mac": "^0.0.6",
    "input-otp": "^1.5.0",
    "mammoth": "^1.12.1",
    "openai": "^6.38.0",
    "pdf-parse": "^1.1.1",
    "radix-ui": "^1.6.7",
    "react-resizable-panels": "^4.12.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^3.7.2",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "build": {
    "appId": "com.kairo.app",
    "productName": "Kairo",
    "copyright": "Copyright \u00a9 2026 Kairo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/{__tests__,test,tests}/**"
    ],
    "extraResources": [
      {
        "from": "resources/bible.db",
        "to": "bible.db"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/grandiose-mac/**"
    ],
    "npmRebuild": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Kairo listens to the service audio so it can transcribe the sermon in real time.",
        "NSLocalNetworkUsageDescription": "Kairo connects to ProPresenter and NDI receivers on your local network.",
        "NSBonjourServices": [
          "_ndi._tcp",
          "_propresenter._tcp"
        ],
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CodeLawd",
        "repo": "proautomate",
        "releaseType": "release"
      }
    ]
  }
}
